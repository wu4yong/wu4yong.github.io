<!--
  ============================================
  分类汇总页面模板
  文件：categories.njk
  适用终端：电脑端
  作用：全部分类总览；手机 UA 跳 /phone/
  最后修改：2026-11-11
  ============================================
--><!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#020817">
    <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
    <style>html{background-color:#020817}</style>
    <title>{{ page.category | default('技术总秘境') }} - 时空秘境</title>
    <!-- 样式：基础层 + 分类页共享，外链引入（源文件 themes/butterfly/source/css/theme/） -->
    <link rel="stylesheet" href="/css/theme/base/common.css">
    <link rel="stylesheet" href="/css/theme/starmap/category-shared.css">
  <script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('/phone/');
    }
  })();
</script>
</head>
  <body>
    {% include "_components/Particles.njk" %}
    <div class="container">
      <div class="header">
        <h1>📁 {{ page.category | default('技术总秘境') }}</h1>
        <a href="/" class="back-home">← 返回首页</a>
      </div>
      <div class="category-group">
        {% if page.category %}
          <h2>{{ displayName(page.category) }}（{{ page.posts | length }} 篇）</h2>
          {% if page.posts | length > 0 %}
            {% for post in page.posts %}
              <div class="post-item">
                <a href="{{ url_for(post.path) }}">{{ post.title }}</a>
              </div>
            {% endfor %}
          {% else %}
            <div class="empty-tip">暂无该分类下的文章</div>
          {% endif %}
        {% else %}
          <div class="empty-tip">请选择分类</div>
        {% endif %}
      </div>
    </div>
  </body>
</html>

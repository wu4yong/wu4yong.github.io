<!--
  ============================================
  分类汇总页面模板
  文件：categories.njk
  作用：展示全部分类，按分类分组展示文章列表
  样式依赖：_css/common.css、_css/categories.css
  组件依赖：_components/Particles.njk
  ============================================
-->
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>{{ page.category | default('技术总秘境') }} - 时空秘境</title>
    <style>
      {% include "_css/common.css" %}
      {% include "_css/categories.css" %}
    </style>
  </head>
  <body>
    {% include "_components/Particles.njk" %}
    <div class="container">
      <div class="header">
        <h1>📁 {{ page.category | default('技术总秘境') }}</h1>
        <a href="/" class="back-home">← 返回首页</a>
      </div>

      <div class="category-group">
        {% set category_name = page.category %}
        {% if category_name %}
          {% set posts = site.categories[category_name] %}
          <h2>{{ category_name | capitalize }}（{{ posts | length }} 篇）</h2>
          {% if posts | length > 0 %}
            {% for post in posts %}
              <div class="post-item">
                <a href="/{{ post.path }}">{{ post.title }}</a>
              </div>
            {% endfor %}
          {% else %}
            <div class="empty-tip">暂无该分类下的文章</div>
          {% endif %}
        {% else %}
          <div class="empty-tip">请选择分类</div>
        {% endif %}
      </div>
    </div>
  </body>
</html>
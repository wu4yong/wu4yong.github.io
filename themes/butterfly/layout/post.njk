<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title> 时空秘境 - {{ page.title }} </title>
    <style>
      {% include "_css/common.css" %}
      {% include "_css/layout.css" %}
      {% include "_css/sidebar.css" %}
    </style>
  </head>
  <body>
    {% include "_components/Particles.njk" %}

    <div class="app-layout">
      {% include "_components/Sidebar.njk" %}

      <main class="main-content">
        <div class="article-card">
          <h1 class="article-title">{{ page.title }}</h1>
          <div class="article-meta">📅 {{ page.date.format('YYYY-MM-DD') }}</div>
          <div class="article-content">{{ page.content }}</div>
        </div>
      </main>
    </div>

    <div class="float-buttons">
      <button id="back-to-top" class="float-btn" title="返回顶部">↑</button>
      <a href="/" class="float-btn" title="返回首页">🏠</a>
    </div>

    <script>
      var backToTopBtn = document.getElementById('back-to-top');
      window.addEventListener('scroll', function () {
        if (window.scrollY > 300) 
          backToTopBtn
            .classList
            .add('show');
        else 
          backToTopBtn
            .classList
            .remove('show');
        }
      );
      backToTopBtn.addEventListener('click', function () {
        window.scrollTo({top: 0, behavior: 'smooth'});
      });
    </script>
  </body>
</html>
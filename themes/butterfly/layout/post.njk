<!--
  ============================================
  文章原文页模板
  文件：post.njk
  适用终端：电脑端
  作用：文章正文 + 侧栏；手机 UA 跳 /phone/p/<slug>/
  最后修改：2026-11-11
  ============================================
-->{% set pageTitle = "时空秘境 - " + page.title %}
{# 样式层级顺序：基础 common → 布局 post-layout → 组件 sidebar → 正文 post #}
{% set pageCss = ["base/common.css", "base/post-layout.css", "base/sidebar.css", "base/post.css"] %}
<!DOCTYPE html>
<html class="post-page">
{% include "_components/Head.njk" %}
<script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('/phone/p/{{ page.slug }}/');
    }
  })();
</script>
<link rel="stylesheet" href="/css/code-table.css">

<body>
  {% include "_components/Particles.njk" %}

  <!-- 返回按钮：按来源回到星图手记 / 星迹索引，默认回星图手记。
       放在 body 顶层（不进 main-content），避免被其溢出裁剪切掉右半边 -->
  <a class="article-back" id="articleBack" href="/archives/">← 返回星图手记</a>

  <div class="app-layout">
    {% include "_components/Sidebar.njk" %}

    {# 折叠按钮：放在aside外部，不受侧边栏transform影响 #}
    <button id="sidebarToggle" class="sidebar-toggle" title="隐藏侧栏"></button>

    <main class="main-content">
      <div class="article-card">
        <h1 class="article-title">{{ page.title }}</h1>
        <div class="article-meta">📅 {{ page.date.format('YYYY-MM-DD') }}</div>
        <div class="article-content">{{ page.content }}</div>
      </div>
    </main>
  </div>

  <div class="float-buttons">
    <button id="back-to-top" class="float-btn" title="返回顶部">↑</button>
    <a href="/" class="float-btn" title="返回首页">🏠</a>
  </div>

  {# sidebar.js 由 _components/Sidebar.njk 内部引入，这里不再重复引入 #}
  <!-- 浮动按钮脚本：外链（源文件 themes/butterfly/source/js/theme/base/post-float-btn.js） -->
  <script src="/js/theme/base/post-float-btn.js"></script>

  {# ========= APlayer Meting 播放器（抽到公共组件） ========= #}
  {% include "_components/APlayer.njk" %}

{# ========= Mermaid 按需加载：本地库 + 星空配色，无 mermaid 图表则不加载 ========= #}
<script>
  /* 作用：懒加载本地 mermaid 库（不走外部 CDN，避免网络波动导致图表不渲染） */
  function loadLocalMermaid(){
    return new Promise(function(resolve, reject){
      if(window.mermaid) return resolve(window.mermaid);
      var s = document.createElement('script');
      s.src = '/js/third-party/mermaid/mermaid.min.js?v=10';
      s.onload = function(){ resolve(window.mermaid); };
      s.onerror = function(){ reject(new Error('mermaid local load failed')); };
      document.head.appendChild(s);
    });
  }

  /* 作用：把 ```mermaid 代码块替换成渲染后的 SVG 图 */
  async function renderMermaidDiagram(){
    var blocks = document.querySelectorAll('pre[class*="language-mermaid"]');
    if(!blocks.length) return;
    var mermaid;
    try { mermaid = await loadLocalMermaid(); }
    catch(e){ console.warn('[mermaid] 本地库加载失败：', e); return; }

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        darkMode: true,
        background: 'transparent',
        fontFamily: '"Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif',
        fontSize: '14px',
        primaryColor: '#062f3d',
        primaryTextColor: '#d6f6ff',
        primaryBorderColor: '#00eeff',
        secondaryColor: '#04222d',
        tertiaryColor: '#04222d',
        mainBkg: '#062f3d',
        nodeBorder: '#00eeff',
        clusterBkg: '#02161f',
        clusterBorder: '#00eeff55',
        lineColor: '#00eeff',
        textColor: '#c0e8ff',
        edgeLabelBackground: '#02161f'
      },
      flowchart: { curve: 'basis', useMaxWidth: true, htmlLabels: false, nodeSpacing: 46, rankSpacing: 64, padding: 14 }
    });

    var targets = [];
    blocks.forEach(function(el){
      var codeEl = el.querySelector('code');
      if(!codeEl) return;
      var div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = codeEl.textContent;
      el.parentNode.replaceChild(div, el);
      targets.push(div);
    });
    if(!targets.length) return;
    try { await mermaid.run({ nodes: targets }); }
    catch(e){ console.warn('[mermaid] 渲染失败：', e); }
  }
  /* 作用：多次触发兜底。某些时机（pjax 局部加载、标签页从后台恢复、库加载慢）
     脚本可能一次没跑到，用「延迟重试 + DOM 变化监听」保证最终一定渲染成图 */
  var mmBusy = false;
  function scheduleMermaid(){
    if(mmBusy) return;
    mmBusy = true;
    renderMermaidDiagram().then(function(){ mmBusy = false; }, function(){ mmBusy = false; });
  }

  document.addEventListener('DOMContentLoaded', scheduleMermaid);
  window.addEventListener('load', scheduleMermaid);
  ['pjax:complete', 'pjax:success', 'render'].forEach(function(ev){
    document.addEventListener(ev, scheduleMermaid);
  });
  [1000, 3000, 8000].forEach(function(ms){ setTimeout(scheduleMermaid, ms); });
  if(document.readyState !== 'loading') scheduleMermaid();

  /* 作用：正文被动态替换（局部刷新 / 回到前台）时再兜一次，防漏渲染 */
  if(window.MutationObserver){
    var mmTimer = null;
    var mmObserver = new MutationObserver(function(){
      clearTimeout(mmTimer);
      mmTimer = setTimeout(scheduleMermaid, 400);
    });
    document.addEventListener('DOMContentLoaded', function(){
      var root = document.querySelector('#article-container') || document.body;
      mmObserver.observe(root, { childList: true, subtree: true });
    });
  }
</script>


  <script>
    /* 返回按钮来源判定：从星迹索引进来回 /tags/，从星图手记进来回 /archives/；
       直接从地址栏/站外进入时默认回星图手记，保证按钮始终可用 */
    (function () {
      var back = document.getElementById('articleBack');
      if (!back) return;
      var from = '';
      try {
        var q = new URLSearchParams(location.search);
        from = q.get('from') || '';
      } catch (e) {}
      if (!from) {
        var ref = document.referrer || '';
        if (ref.indexOf('/tags') > -1) from = 'tags';
        else if (ref.indexOf('/archives') > -1) from = 'archive';
      }
      if (from === 'tags') {
        back.href = '/tags/';
        back.textContent = '← 返回星迹索引';
      } else if (from === 'search') {
        back.href = '/';
        back.textContent = '← 返回首页';
      } else {
        back.href = '/archives/';
        back.textContent = '← 返回星图手记';
      }
    })();
  </script>
</body>
</html>
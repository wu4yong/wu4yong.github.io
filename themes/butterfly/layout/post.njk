<!--
  ============================================
  文章详情页面模板
  文件：post.njk
  作用：展示单篇文章正文、左侧侧边栏、返回顶部悬浮按钮
  样式依赖：_css/common.css、_css/post-layout.css、_css/sidebar.css
  脚本依赖：_js/post-float-btn.js
  组件依赖：_components/Particles.njk、_components/Sidebar.njk
  ============================================
-->
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title> 时空秘境 - {{ page.title }} </title>
    <style>
      {% include "_css/common.css" %}
      {% include "_css/post-layout.css" %}
      {% include "_css/sidebar.css" %}
       {% include "_css/post.css" %} 
    </style>
  </head>
  <body>
    {% include "_components/Particles.njk" %}

    <div class="app-layout">
      {% include "_components/Sidebar.njk" %}

      {# 折叠按钮：放在aside外部，不受侧边栏transform影响 #}
        <button id="sidebarToggle" class="sidebar-toggle"></button>
        
      <main class="main-content">
        <div class="article-card">
          <h1 class="article-title">{{ page.title }}</h1>
          <div class="article-meta">📅 {{ page.date.format('YYYY-MM-DD') }}</div>
          <div class="article-content">{{ page.content }}</div>
        </div>
      </main>
    </div>

    <div class="float-buttons">
      <button id="back-to-top" class="float-btn" title="返回顶部">↑</button>
      <a href="/" class="float-btn" title="返回首页">🏠</a>
    </div>

    <script>
      {% include "_js/post-float-btn.js" %}
      {% include "_js/sidebar.js" %}
    </script>

    {# ========= Mermaid 按需加载脚本 ========= #}
    <script>
async function transformMermaidBlocks() {
  const blocks = document.querySelectorAll('figure.highlight.plaintext');
  let needMermaid = false;
  let mermaidBlocks = [];

  for(const fig of blocks){
    const codeText = fig.querySelector('td.code').innerText.trim();
    if (codeText.startsWith('flowchart') || codeText.startsWith('sequenceDiagram')) {
      needMermaid = true;
      mermaidBlocks.push({fig, codeText});
    }
  }

  // 当前文章页面没有mermaid图表，直接退出，不去下载库
  if(!needMermaid){
    return;
  }

  // 动态import，只有需要绘图的时候才加载mermaid模块
  const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

  // DOM替换：highlight代码块 → mermaid div
  for(const {fig,codeText} of mermaidBlocks){
    const div = document.createElement('div');
    div.className = 'mermaid';
    div.textContent = codeText;
    fig.replaceWith(div);
  }

  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    themeVariables: {
      darkMode: true,
      background: '#020817',

      // ========== 流程图配色 ==========
      primaryColor: '#042b38',
      primaryTextColor: '#cdefff',
      primaryBorderColor: '#00eeff',
      lineColor: '#00eeff',

      // ========== 时序图配色 ==========
      actorBkg: '#042b38',
      actorTextColor: '#cdefff',
      actorBorderColor: '#00eeff',
      signalColor: '#00eeff',
      signalTextColor: '#c0e8ff',
      noteBkgColor: '#0b2a3a',
      noteTextColor: '#c0e8ff',
      noteBorderColor: '#00eeff'
    },
    themeCSS: `
        .mermaid .node rect,.mermaid .node polygon,.mermaid .node path {stroke:#00eeff !important;stroke-width:1.5px !important;filter: drop-shadow(0 0 6px #00eeff55);}
        .mermaid .edgePath path {stroke:#00eeff !important;stroke-width:2px !important;filter: drop-shadow(0 0 5px #00eeff80);}
        .mermaid .actor {stroke:#00eeff !important;fill:#042b38 !important;filter: drop-shadow(0 0 6px #00eeff55);}
        .mermaid .messageLine0,.mermaid .messageLine1 {stroke:#00eeff !important;stroke-width:2px !important;filter: drop-shadow(0 0 5px #00eeff80);}
        .mermaid .activation {stroke:#00eeff !important;fill:#0a3d4e !important;filter: drop-shadow(0 0 6px #00eeff55);}
        .mermaid .loop text,.mermaid .note text {fill:#c0e8ff !important;}
        .mermaid .loop rect,.mermaid .note rect {stroke:#00eeff !important;fill:#0b2a3a !important;filter: drop-shadow(0 0 6px #00eeff44);}
        .mermaid text {fill:#cdefff !important;}
      `
  });
  await mermaid.run();
}

document.addEventListener('DOMContentLoaded',transformMermaidBlocks);

    </script>
    
  </body>
</html>
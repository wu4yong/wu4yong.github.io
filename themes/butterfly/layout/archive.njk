<!--
  ============================================
  归档页面模板
  文件：archive.njk
  作用：总归档 + 按月归档共用模板，自动区分
  样式依赖：_css/common.css、_css/archive.css
  组件依赖：_components/Particles.njk
  ============================================
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>旅途卷宗 - 时空秘境</title>
<style>
  {% include "_css/common.css" %}
  {% include "_css/archive.css" %}
</style>
</head>
<body>
  <!-- 星空粒子背景组件 -->
  {% include "_components/Particles.njk" %}

  <div class="container">
    <div class="header">
      <h1>📜 旅途卷宗
        {% if page.year and page.month %}
          - {{ page.year }}年{{ page.month }}月
        {% endif %}
      </h1>
      <a href="/" class="back-home">← 返回首页</a>
    </div>
    <div class="post-list">
      {# 先拿到所有文章，倒序（新的在前） #}
      {% set allPosts = site.posts.toArray() | sort(true, false, 'date') %}
      {% for post in allPosts %}
        {# 如果是按月归档页面，就做年月过滤；总归档页直接全部展示 #}
        {% if not (page.year and page.month) or (post.date.year() === page.year and post.date.month() + 1 === page.month) %}
          <div class="post-item">
            <span style="color:#88aaff; font-size:14px; margin-right:15px;">{{ post.date.format('YYYY-MM-DD') }}</span>
            <a href="/{{ post.path }}">{{ post.title }}</a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</body>
</html>
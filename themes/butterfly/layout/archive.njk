<!--
  ============================================
  归档页面模板
  文件：archive.njk
  作用：显示所有文章列表
  ============================================
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>旅途卷宗 - 时空秘境</title>
<style>
  {% include "_css/common.css" %}
</style>
</head>
<body>
  <!-- 星空粒子背景组件 -->
  {% include "_components/Particles.njk" %}

  <div class="container">
    <div class="header">
      <h1>📜 旅途卷宗</h1>
      <a href="/" class="back-home">← 返回首页</a>
    </div>
    <div class="post-list">
      {% for post in site.posts.toArray() %}
      <div class="post-item">
        <a href="/{{ post.path }}">{{ post.title }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</body>
</html>

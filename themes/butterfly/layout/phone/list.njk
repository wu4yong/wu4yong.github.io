<!--
  ============================================
  手机端 · 分类 / 标签文章列表页
  文件：phone/list.njk
  适用终端：手机端（路由 /phone/c/<分类>/、/phone/t/<标签>/）
  作用：手机点击首页菜单后落到的列表页，竖排文章卡片，点进 /phone/p/ 阅读
        数据由 scripts/phone-routes.js 在生成期算好（page.title / page.items）
  样式依赖：source/css/theme/phone/common.css、source/css/theme/phone/list.css
  组件依赖：phone/_components/Particles.njk
  最后修改：2026-11-11
  ============================================
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#020817">
  <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
  <style>html{background-color:#020817}</style>
  <title>{{ page.title }} - 时空秘境</title>
  <!-- 手机端样式：基础 + 列表/正文，外链引入（源文件 source/css/theme/phone/） -->
  <link rel="stylesheet" href="/css/theme/phone/common.css">
  <link rel="stylesheet" href="/css/theme/phone/list.css">
</head>
<body>
<div class="mb-shell">
  {% include "_components/Particles.njk" %}

  <div class="mb-top">
    <a class="mb-back" href="/phone/">← 返回手机首页</a>
    <span class="mb-sub" style="margin:0">{{ page.items.length }} 篇</span>
  </div>

  <h1 class="mb-title">{{ page.title }}</h1>
  <div class="mb-sub">{{ page.sub }} · 共 {{ page.items.length }} 篇，点击标题进入阅读</div>

  <div class="mb-list">
    {% for it in page.items %}
    <a class="mb-item" href="{{ it.u }}">
      <span class="mb-item-title">{{ it.t }}</span>
      <span class="mb-item-meta">{{ it.d }}</span>
    </a>
    {% endfor %}
  </div>

  <div class="mb-foot">
    <a href="/phone/">返回手机首页</a>
    <a href="/phone/tags/">星迹索引</a>
  </div>
</div>
</body>
</html>
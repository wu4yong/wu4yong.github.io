<!--
  ============================================
  手机端 · 星迹索引（标签云）
  文件：phone/tags.njk
  适用终端：手机端（路由 /phone/tags/）
  作用：手机端标签总览，点击标签进入 /phone/t/<标签>/ 列表
        数据由 scripts/phone-routes.js 在生成期算好（page.chips）
  样式依赖：source/css/theme/phone/common.css、source/css/theme/phone/list.css
  组件依赖：phone/_components/Particles.njk
  最后修改：2026-11-11
  ============================================
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#020817">
  <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
  <style>html{background-color:#020817}</style>
  <title>星迹索引 - 时空秘境</title>
  <!-- 手机端样式：基础 + 列表/正文，外链引入（源文件 source/css/theme/phone/） -->
  <link rel="stylesheet" href="/css/theme/phone/common.css">
  <link rel="stylesheet" href="/css/theme/phone/list.css">
</head>
<body>
<div class="mb-shell">
  {% include "_components/Particles.njk" %}

  <div class="mb-top">
    <a class="mb-back" href="/phone/">← 返回手机首页</a>
    <span class="mb-sub" style="margin:0">{{ page.chips.length }} 个标签</span>
  </div>

  <h1 class="mb-title">星迹索引</h1>
  <div class="mb-sub">按标签检索全部档案，点击进入该标签下的文章列表</div>

  <div class="mb-tags">
    {% for ch in page.chips %}
    <a class="mb-chip" href="{{ ch.u }}">{{ ch.n }} <b>{{ ch.c }}</b></a>
    {% endfor %}
  </div>

  <div class="mb-foot">
    <a href="/phone/">返回手机首页</a>
    <a href="/phone/about/">秘境主人</a>
  </div>
</div>
</body>
</html>
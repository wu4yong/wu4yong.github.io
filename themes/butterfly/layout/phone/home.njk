<!--
  ============================================
  手机端首页（移动入口）
  文件：layout/phone/home.njk
  适用终端：手机端；由 source/phone/index.md（layout: phone/home）渲染到 /phone/
  页面描述：沿用原 Butterfly 风格首页 —— 打字机标题、折叠分类菜单、
            星迹索引 / 秘境主人入口
  样式依赖：source/css/theme/base/common.css、source/css/theme/phone/home.css、source/css/theme/phone/home-animation.css
  组件依赖：_components/Particles.njk、phone/_components/home-content.njk
  脚本依赖：source/js/theme/phone/home-typing.js、source/js/theme/phone/home-parallax.js
  最后修改：2026-11-11
  ============================================
-->
<!DOCTYPE html>
<html lang="zh-CN" class="phone-page">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#020817">
    <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
    <style>html{background-color:#020817}</style>
    <title>{{ config.title }} · 手机端</title>
    <!-- 手机端样式：基础 → 首页 → 首页动画，外链引入（源文件 source/css/theme/phone/） -->
    <link rel="stylesheet" href="/css/theme/phone/common.css">
    <link rel="stylesheet" href="/css/theme/phone/home.css">
    <link rel="stylesheet" href="/css/theme/phone/home-animation.css">
  </head>
  <body class="phone-body">
    <!-- 星空粒子背景组件 -->
    {% include "_components/Particles.njk" %}

    <!-- 手机首页内容组件（标题、折叠菜单、入口按钮） -->
    {% include "_components/home-content.njk" %}

    <!-- 手机首页脚本：打字机 + 视差，外链引入（源文件 source/js/theme/phone/） -->
    <script src="/js/theme/phone/home-typing.js"></script>
    <script src="/js/theme/phone/home-parallax.js"></script>

    <script>
      /* ---- 电脑端分流：PC 访问移动入口时先把人送回新电脑首页 ----
         带 ?stay=1 时不跳（方便在电脑上预览手机版） */
      (function () {
        var ua = navigator.userAgent || '';
        var isMobile = /Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua);
        if (!isMobile && location.search.indexOf('stay=1') < 0) {
          window.location.replace('/');
        }
      })();
    </script>
  </body>
</html>

<!--
  ============================================
  手机端 · 秘境主人
  文件：phone/about.njk
  适用终端：手机端（路由 /phone/about/）
  作用：手机端关于页，正文复用 source/about/index.md（生成期注入 page.aboutHtml）
  样式依赖：source/css/theme/phone/common.css、source/css/theme/phone/list.css
  组件依赖：phone/_components/Particles.njk
  最后修改：2026-11-11
  ============================================
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#020817">
  <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
  <style>html{background-color:#020817}</style>
  <title>秘境主人 - 时空秘境</title>
  <!-- 手机端样式：基础 + 列表/正文，外链引入（源文件 source/css/theme/phone/） -->
  <link rel="stylesheet" href="/css/theme/phone/common.css">
  <link rel="stylesheet" href="/css/theme/phone/list.css">
</head>
<body>
<div class="mb-shell">
  {% include "_components/Particles.njk" %}

  <div class="mb-top">
    <a class="mb-back" href="/phone/">← 返回手机首页</a>
  </div>

  <h1 class="mb-title">秘境主人</h1>
  <div class="mb-sub">关于这个站点与写它的人</div>

  <div class="mb-article">
    {% if page.aboutHtml %}{{ page.aboutHtml | safe }}{% else %}<p>关于页正文未找到，请检查 source/about/index.md。</p>{% endif %}
  </div>

  <div class="mb-foot">
    <a href="/phone/">返回手机首页</a>
    <a href="/phone/tags/">星迹索引</a>
  </div>
</div>
</body>
</html>
<!--
  ============================================
  手机端 · 文章原文页
  文件：phone/post.njk
  适用终端：手机端（路由 /phone/p/<slug>/，由 scripts/phone-routes.js 生成）
  作用：手机阅读单篇文章；单列布局、无侧栏无雷达，替代电脑端 post.njk
        数据由生成期算好：page.item = { title, dateStr, content, cats, tags }
  样式依赖：source/css/theme/phone/common.css、source/css/theme/phone/list.css
  组件依赖：phone/_components/Particles.njk
  最后修改：2026-11-11
  ============================================
-->
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#020817">
  <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
  <style>html{background-color:#020817}</style>
  <title>{{ page.item.title }} - 时空秘境</title>
  <!-- 手机端样式：基础 + 列表/正文，外链引入（源文件 source/css/theme/phone/） -->
  <link rel="stylesheet" href="/css/theme/phone/common.css">
  <link rel="stylesheet" href="/css/theme/phone/list.css">
</head>
<body>
<div class="mb-shell">
  {% include "_components/Particles.njk" %}

  <div class="mb-top">
    <a class="mb-back" href="/phone/">← 返回手机首页</a>
    <span class="mb-sub" style="margin:0">{{ page.item.dateStr }}</span>
  </div>

  <h1 class="mb-title">{{ page.item.title }}</h1>
  <div class="mb-sub">
    {% if page.item.cats %}分类：{{ page.item.cats }}{% endif %}
    {% if page.item.tags %} ｜ 标签：{{ page.item.tags }}{% endif %}
  </div>

  <div class="mb-article">{{ page.item.content | safe }}</div>

  <div class="mb-foot">
    <a href="/phone/">返回手机首页</a>
    <a href="/phone/tags/">星迹索引</a>
  </div>
</div>

{# ========= Mermaid 按需加载：本地库（与电脑端共用 /js/third-party/mermaid/mermaid.min.js） ========= #}
<script>
  /* 作用：懒加载本地 mermaid 库；无 mermaid 代码块时不加载 */
  function loadLocalMermaid(){
    return new Promise(function(resolve, reject){
      if(window.mermaid) return resolve(window.mermaid);
      var s = document.createElement('script');
      s.src = '/js/third-party/mermaid/mermaid.min.js?v=10';
      s.onload = function(){ resolve(window.mermaid); };
      s.onerror = function(){ reject(new Error('mermaid local load failed')); };
      document.head.appendChild(s);
    });
  }

  /* 作用：把 ```mermaid 代码块替换成 SVG 图（手机端字号略小、图可横向滚动） */
  async function renderMermaidDiagram(){
    var blocks = document.querySelectorAll('pre[class*="language-mermaid"]');
    if(!blocks.length) return;
    var mermaid;
    try { mermaid = await loadLocalMermaid(); }
    catch(e){ console.warn('[mermaid] 本地库加载失败：', e); return; }

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        darkMode: true,
        background: 'transparent',
        fontFamily: '"Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif',
        fontSize: '12px',
        primaryColor: '#062f3d',
        primaryTextColor: '#d6f6ff',
        primaryBorderColor: '#00eeff',
        secondaryColor: '#04222d',
        tertiaryColor: '#04222d',
        mainBkg: '#062f3d',
        nodeBorder: '#00eeff',
        clusterBkg: '#02161f',
        clusterBorder: '#00eeff55',
        lineColor: '#00eeff',
        textColor: '#c0e8ff',
        edgeLabelBackground: '#02161f'
      },
      flowchart: { curve: 'basis', useMaxWidth: false, htmlLabels: false, nodeSpacing: 30, rankSpacing: 40, padding: 10 }
    });

    var targets = [];
    blocks.forEach(function(el){
      var codeEl = el.querySelector('code');
      if(!codeEl) return;
      var div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = codeEl.textContent;
      el.parentNode.replaceChild(div, el);
      targets.push(div);
    });
    if(!targets.length) return;
    try { await mermaid.run({ nodes: targets }); }
    catch(e){ console.warn('[mermaid] 渲染失败：', e); }
  }
  /* 作用：多次触发兜底（延迟重试 + DOM 变化），防止某次时机没跑到导致图表留在代码块 */
  var mmBusy = false;
  function scheduleMermaid(){
    if(mmBusy) return;
    mmBusy = true;
    renderMermaidDiagram().then(function(){ mmBusy = false; }, function(){ mmBusy = false; });
  }
  scheduleMermaid();
  window.addEventListener('load', scheduleMermaid);
  [1000, 3000, 8000].forEach(function(ms){ setTimeout(scheduleMermaid, ms); });
  if(document.readyState !== 'loading') scheduleMermaid();
  if(window.MutationObserver){
    var mmTimer = null;
    var mmObserver = new MutationObserver(function(){
      clearTimeout(mmTimer);
      mmTimer = setTimeout(scheduleMermaid, 400);
    });
    mmObserver.observe(document.querySelector('.mb-article') || document.body, { childList: true, subtree: true });
  }
</script>
</body>
</html>
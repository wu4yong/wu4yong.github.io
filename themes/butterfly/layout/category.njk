<!--
  ============================================
  单分类页面模板
  文件：category.njk
  适用终端：电脑端
  作用：某分类下文章列表；手机 UA 跳 /phone/c/<分类>/
  最后修改：2026-11-11
  ============================================
--><!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#020817">
  <!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
  <style>html{background-color:#020817}</style>
  <title>{{ page.category }} - 时空秘境</title>
  <!-- 样式：基础层 + 分类页共享，外链引入（源文件 themes/butterfly/source/css/theme/） -->
  <link rel="stylesheet" href="/css/theme/base/common.css">
  <link rel="stylesheet" href="/css/theme/starmap/category-shared.css">
<script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('/phone/c/{{ page.path | replace("categories/", "") | replace("/index.html", "") }}/');
    }
  })();
</script>
</head>
<body>
  {% include "_components/Particles.njk" %}
  <div class="container">
    <div class="header">
      <h1>📁 {{ displayName(page.category) }}</h1>
      <a href="/" class="back-home">← 返回首页</a>
    </div>
    <div class="category-group">
      {% set category_name = page.category %}
      <h2>{{ displayName(category_name) }}</h2>
      {# 遍历所有文章，筛选出分类匹配的 #}
      {% set matched_posts = [] %}
      {% for post in site.posts.toArray() %}
      {% if post.categories %}
      {% for cat in post.categories.toArray() %}
      {% if cat.name == category_name %}
      {% set matched_posts = matched_posts.concat([post]) %}
      {% endif %}
      {% endfor %}
      {% endif %}
      {% endfor %}
      {% if matched_posts | length > 0 %}
      {% for post in matched_posts %}
      <div class="post-item">
        <a href="{{ url_for(post.path) }}">{{ post.title }}</a>
      </div>
      {% endfor %}
      {% else %}
      <div class="empty-tip">暂无该分类下的文章</div>
      {% endif %}
    </div>
  </div>
</body>
</html>

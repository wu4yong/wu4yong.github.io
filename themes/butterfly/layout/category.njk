<!--
  ============================================
  单个分类页面模板
  作用：显示某个分类下的所有文章
  ============================================
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>{{ page.category }} - 时空秘境</title>
<style>
{% include "_css/common.css" %}
body { background: #020817 !important; color: #e0fcff; }
.container { position: relative; z-index: 10; max-width: 900px; margin: 60px auto; padding: 0 20px; }
.header { text-align: center; margin-bottom: 40px; }
.header h1 { color: #00eeff; font-size: 32px; }
.back-home { display: inline-block; background: rgba(0, 32, 65, 0.95); color: #fff; border: 2px solid #00eeff; border-radius: 14px; padding: 8px 20px; text-decoration: none; }
.back-home:hover { box-shadow: 0 0 20px #00eeff; }
.category-group { background: rgba(0, 22, 45, 0.9); border: 2px solid #00eeff; border-radius: 18px; padding: 30px; margin-top: 20px; }
.category-group h2 { color: #00eeff; font-size: 24px; border-bottom: 1px solid rgba(0, 238, 255, 0.3); padding-bottom: 10px; }
.post-item { padding: 12px 0; border-bottom: 1px solid rgba(0, 238, 255, 0.2); }
.post-item:last-child { border-bottom: none; }
.post-item a { color: #e0fcff; font-size: 18px; text-decoration: none; }
.post-item a:hover { color: #00eeff; }
.empty-tip { text-align: center; padding: 40px; color: #88ccff; }
</style>
</head>
<body>
{% include "_components/Particles.njk" %}
<div class="container">
  <div class="header">
    <h1>📁 {{ page.category | capitalize }}</h1>
    <a href="/" class="back-home">← 返回首页</a>
  </div>

  <div class="category-group">
    {% set category_name = page.category %}
    <h2>{{ category_name | capitalize }} 分类文章</h2>
    
    {# 遍历所有文章，筛选出分类匹配的 #}
    {% set matched_posts = [] %}
    {% for post in site.posts.toArray() %}
      {% if post.categories %}
        {% for cat in post.categories.toArray() %}
          {% if cat.name == category_name %}
            {% set matched_posts = matched_posts.concat([post]) %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
    
    {% if matched_posts | length > 0 %}
      {% for post in matched_posts %}
        <div class="post-item">
          <a href="/{{ post.path }}">{{ post.title }}</a>
        </div>
      {% endfor %}
    {% else %}
      <div class="empty-tip">暂无该分类下的文章</div>
    {% endif %}
  </div>
</div>
</body>
</html>

<!--
  ============================================
  标签索引页面模板
  文件：tags.njk
  作用：显示所有标签列表
  样式依赖：_css/common.css、_css/tags.css
  组件依赖：_components/Particles.njk
  ============================================
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>星标索引 - 时空秘境</title>
<style>
  {% include "_css/common.css" %}
  {% include "_css/tags.css" %}
</style>
</head>
<body>
  {% include "_components/Particles.njk" %}

  <div class="container">
    <div class="header">
      <h1>星标索引</h1>
      <a href="/" class="back-home">← 返回首页</a>
    </div>
    <div class="tag-cloud">
      {% for tag in site.tags.toArray() | sort(false, false, 'name') %}
        <span class="tag-item">
          <a href="/tags/{{ tag.slug }}/">
            {{ tag.name }}
            <span class="tag-count">({{ tag.posts.length }})</span>
          </a>
        </span>
      {% endfor %}
    </div>
  </div>
</body>
</html>

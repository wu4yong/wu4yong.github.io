<!--
  ============================================
  秘境主人页面模板
  文件：about.njk
  适用终端：电脑端
  作用：电脑端关于页；手机 UA 自动跳 /phone/about/
  最后修改：2026-11-11
  ============================================
-->{# 样式层级顺序：基础 common → 布局 post-layout → 组件 sidebar → 正文 post → 页面 tags/about → 特效 starmap-live #}
{% set pageCss = ["base/common.css", "base/post-layout.css", "base/sidebar.css", "base/post.css", "starmap/tags.css", "home/about.css?v=20261124a", "starmap/starmap-live.css"] %}
{% set pageTitle = "秘境主人 - 时空秘境" %}
<!DOCTYPE html>
<html class="post-page">
{% include "_components/Head.njk" %}
<script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('/phone/about/');
    }
  })();
</script>
<body>
  {% include "_components/Particles.njk" %}

  <div class="app-layout">
    {% include "_components/Sidebar.njk" %}

    {# 折叠按钮：放在 aside 外部，不受侧边栏 transform 影响 #}
    <button id="sidebarToggle" class="sidebar-toggle" title="隐藏侧栏"></button>

    <main class="main-content about-main">
      <div class="starmap-console">
        <header class="console-header">
          <div class="console-title">
            <span class="title-dot"></span>
            <span class="title-label">秘境主人</span>
            <span class="title-divider">·</span>
            <span class="title-en">ABOUT ME</span>
          </div>
          <div class="console-status">
            <div class="status-item">
              <span class="status-dot dot-scan"></span>
              <span class="status-text">PROFILE</span>
            </div>
            <div class="status-item">
              <span class="status-dot dot-node"></span>
              <span class="status-text">ARTICLES: {{ site.posts.length }}</span>
            </div>
            <div class="status-item">
              <span class="status-dot dot-link"></span>
              <span class="status-text">NODES: {{ site.tags.length }}</span>
            </div>
          </div>
          <a href="{{ url_for('/') }}" class="back-home">
            <span class="back-home-icon">←</span>
            <span>返回首页</span>
          </a>
          <span class="header-scan-line"></span>
        </header>

        <main class="starmap-main about-grid">
          <!-- 左栏：档案坐标 -->
          <aside class="starmap-panel left-panel">
            <div class="panel-title">
              <span class="panel-icon">●</span>
              <span>成长坐标 / LIFE COORDS</span>
            </div>
            <div class="about-meta">
              <div class="about-meta-row">
                <span>档案名</span>
                <span class="about-meta-value">{{ page.title }}</span>
              </div>
              {% if page.date %}
                <div class="about-meta-row">
                  <span>更新时间</span>
                  <span class="about-meta-value">{{ page.date.format('YYYY.MM.DD') }}</span>
                </div>
              {% endif %}
              <div class="about-meta-row">
                <span>入档章节</span>
                <span class="about-meta-value" id="chapterCount">--</span>
              </div>
            </div>
            <div class="coord-grid about-chapters" id="chapterList">
              <!-- 档案坐标列表下方空白区：旋转点阵地球仪（背景层，不挡点击） -->
              <div class="globe-box" id="globeBox" aria-hidden="true">
                <canvas id="globeCanvas"></canvas>
              </div>
              <!-- 章节坐标由页面底部脚本从正文标题自动生成 -->
            </div>
          </aside>

          <!-- 中栏：正文 -->
          <section class="starmap-panel article-panel">
            <div class="article-head">
              <span class="article-head-title">{{ page.title }}</span>
              {% if page.date %}
                <span class="article-head-date">LAST SYNC: {{ page.date.format('YYYY.MM.DD') }}</span>
              {% endif %}
            </div>
            <div class="article-content" id="aboutContent">
              {{ page.content }}
            </div>
          </section>

          <!-- 右栏：4 个子卡片（站点指标挪进「出口」卡，这里换成能看出这是个什么人的东西） -->
          <aside class="starmap-panel right-panel">
            <!-- 1 主人档案 -->
            <div class="sub-card op-card">
              <div class="panel-title">
                <span class="panel-icon">●</span>
                <span>主人档案 / OPERATOR</span>
              </div>
              <div class="about-meta op-meta">
                <div class="about-meta-row">
                  <span>身份</span>
                  <span class="about-meta-value">后端工程师</span>
                </div>
                <div class="about-meta-row">
                  <span>主线</span>
                  <span class="about-meta-value">Java 微服务 / AIGC 应用</span>
                </div>
                <div class="about-meta-row">
                  <span>状态</span>
                  <span class="about-meta-value op-live"><i class="op-live-dot"></i>持续构建中</span>
                </div>
                <div class="about-meta-row">
                  <span>坐标</span>
                  <span class="about-meta-value">CN · ONLINE</span>
                </div>
              </div>
            </div>

            <!-- 2 能力矩阵 -->
            <div class="sub-card op-stack-card">
              <div class="panel-title">
                <span class="panel-icon">●</span>
                <span>能力矩阵 / STACK</span>
              </div>
              <div class="op-stack">
                <div class="op-stack-group">
                  <span class="op-stack-label">后端服务</span>
                  <div class="op-chips">
                    <span class="op-chip">Java</span>
                    <span class="op-chip">Spring Boot</span>
                    <span class="op-chip">Spring Cloud</span>
                    <span class="op-chip">Dubbo</span>
                  </div>
                </div>
                <div class="op-stack-group">
                  <span class="op-stack-label">数据存储</span>
                  <div class="op-chips">
                    <span class="op-chip">MySQL</span>
                    <span class="op-chip">Redis</span>
                    <span class="op-chip">消息队列</span>
                  </div>
                </div>
                <div class="op-stack-group">
                  <span class="op-stack-label">前端页面</span>
                  <div class="op-chips">
                    <span class="op-chip">Vue</span>
                    <span class="op-chip">Hexo</span>
                    <span class="op-chip">CSS 动效</span>
                  </div>
                </div>
                <div class="op-stack-group">
                  <span class="op-stack-label">AIGC</span>
                  <div class="op-chips">
                    <span class="op-chip">Spring AI</span>
                    <span class="op-chip">LangChain</span>
                    <span class="op-chip">RAG</span>
                    <span class="op-chip">ComfyUI</span>
                    <span class="op-chip">Ollama</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3 星图频谱 -->
            <div class="sub-card">
              <div class="panel-title">
                <span class="panel-icon">●</span>
                <span>星图频谱 / SPECTRUM</span>
              </div>
              <div class="local-time">LOCAL TIME: <span id="localTime">--:--:--</span></div>
              <div class="spectrum-box">
                <div class="spectrum-bars">
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                  <span class="bar"></span>
                </div>
              </div>
            </div>

            <!-- 4 出口：比起堆十条假日志，这里给能点走出去的链接 + 站点规模 -->
            <div class="sub-card op-out-card">
              <div class="panel-title">
                <span class="panel-icon">●</span>
                <span>出口 / OUTPOSTS</span>
              </div>
              <ul class="op-out-links">
                <li>
                  <a href="https://github.com/wu4yong" target="_blank" rel="noopener">GitHub · wu4yong</a>
                  <span>站点与图床仓库</span>
                </li>
                <li>
                  <a href="https://gitee.com/wu4yong" target="_blank" rel="noopener">Gitee · wu4yong</a>
                  <span>国内镜像</span>
                </li>
              </ul>
              <div class="about-meta op-meta op-out-stats">
                <div class="about-meta-row">
                  <span>文章记录</span>
                  <span class="about-meta-value">{{ site.posts.length }}</span>
                </div>
                <div class="about-meta-row">
                  <span>标签节点</span>
                  <span class="about-meta-value">{{ site.tags.length }}</span>
                </div>
                <div class="about-meta-row">
                  <span>分类星区</span>
                  <span class="about-meta-value">{{ site.categories.length }}</span>
                </div>
              </div>
            </div>
          </aside>

          <!-- 底部：轨道数据带 -->
          <footer class="bottom-panel">
            <div class="bottom-title">
              <span class="panel-icon">●</span>
              <span>轨迹数据带 / TRACK DATA STRIP</span>
            </div>
            <div class="orbital-track">
              <div class="orbital-line line-1"></div>
              <div class="orbital-line line-2"></div>
              <div class="orbital-line line-3"></div>
              <div class="orbital-line line-4"></div>
              <span class="orbital-dot t1-dot1"></span>
              <span class="orbital-dot t1-dot2"></span>
              <span class="orbital-dot t2-dot1"></span>
              <span class="orbital-dot t2-dot2"></span>
              <span class="orbital-dot t3-dot1"></span>
              <span class="orbital-dot t3-dot2"></span>
              <span class="orbital-dot t4-dot1"></span>
              <span class="orbital-dot t4-dot2"></span>
            </div>
          </footer>
        </main>
      </div>
    </main>
  </div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  /* ---------- 1. 从正文标题自动生成章节坐标 ---------- */
  var content = document.getElementById('aboutContent');
  var list = document.getElementById('chapterList');
  var countDom = document.getElementById('chapterCount');

  if (content && list) {
    /* 把正文按标题切成若干章节：每个标题 + 其后直到下一个标题之前的所有节点。
       点左栏某一章时，只保留该章节点，其余整段隐藏，实现「只显示这一章的内容」。 */
    var allNodes = Array.prototype.slice.call(content.children);
    var heads = Array.prototype.slice.call(content.querySelectorAll('h1, h2, h3'));
    var sections = [];
    var lead = [];
    var cur = null;
    allNodes.forEach(function (node) {
      if (heads.indexOf(node) >= 0) {
        cur = { head: node, nodes: [node] };
        sections.push(cur);
      } else if (cur) {
        cur.nodes.push(node);
      } else {
        lead.push(node);
      }
    });

    var rows = [];
    var activeRow = null;

    function scroller() {
      var p = content.parentElement;
      while (p) {
        var oy = p.style.overflowY || window.getComputedStyle(p).overflowY;
        if (oy === 'auto' || oy === 'scroll') return p;
        p = p.parentElement;
      }
      return content;
    }

    function markActive(row) {
      if (activeRow) activeRow.classList.remove('is-reading');
      activeRow = row;
      if (row) row.classList.add('is-reading');
    }

    function showAllNodes() {
      allNodes.forEach(function (n) { n.style.display = ''; });
    }

    function showOnly(sec) {
      allNodes.forEach(function (n) { n.style.display = 'none'; });
      sec.nodes.forEach(function (n) { n.style.display = ''; });
      scroller().scrollTop = 0;
    }

    /* 「全文」入口：恢复整篇 */
    var fullRow = document.createElement('div');
    fullRow.className = 'coord-item coord-level-high';
    var fullDot = document.createElement('span');
    fullDot.className = 'coord-dot';
    var fullTag = document.createElement('span');
    fullTag.className = 'chapter-tag tag-main';
    fullTag.textContent = '全';
    var fullLink = document.createElement('a');
    fullLink.href = '#';
    fullLink.textContent = '全文预览';
    fullRow.appendChild(fullDot);
    fullRow.appendChild(fullTag);
    fullRow.appendChild(fullLink);
    fullLink.addEventListener('click', function (e) {
      e.preventDefault();
      showAllNodes();
      scroller().scrollTop = 0;
      markActive(fullRow);
    });
    list.appendChild(fullRow);
    rows.push(fullRow);

    sections.forEach(function (sec, i) {
      var h = sec.head;
      var level = h.tagName.toLowerCase();
      var text = (h.textContent || '').trim();
      if (!text) return;
      h.id = 'sec-' + i;

      var row = document.createElement('div');
      row.className = 'coord-item ' + (level === 'h1' ? 'coord-level-high' : (level === 'h2' ? 'coord-level-mid' : 'coord-level-low'));

      var dot = document.createElement('span');
      dot.className = 'coord-dot';

      var tag = document.createElement('span');
      tag.className = 'chapter-tag' + (level === 'h1' ? ' tag-main' : '');
      tag.textContent = level === 'h1' ? '主' : (level === 'h2' ? '节' : '子');

      var link = document.createElement('a');
      link.href = '#' + h.id;
      link.textContent = text;
      link.addEventListener('click', function (e) {
        e.preventDefault();
        showOnly(sec);
        markActive(row);
      });

      row.appendChild(dot);
      row.appendChild(tag);
      row.appendChild(link);
      row.addEventListener('mouseenter', function () { row.classList.add('active-row'); });
      list.appendChild(row);
      rows.push(row);
    });

    if (countDom) countDom.textContent = sections.length;
    if (!sections.length) {
      var empty = document.createElement('div');
      empty.className = 'coord-item coord-level-low';
      empty.textContent = '未解析到章节标题';
      list.appendChild(empty);
    }
  }

  /* ---------- 2. 本地时间 + 日志时间 ---------- */
  function pad(num) { return num < 10 ? '0' + num : num; }
  function updateLocalTime() {
    var now = new Date();
    var full = now.getFullYear() + '.' + pad(now.getMonth() + 1) + '.' + pad(now.getDate())
      + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
    var timeText = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
    var timeDom = document.getElementById('localTime');
    if (timeDom) timeDom.textContent = timeText;
    document.querySelectorAll('.log-time').forEach(function (el) { el.textContent = full; });
  }
  updateLocalTime();
  setInterval(updateLocalTime, 1000);

  /* ---------- 3. 正文内图片加载后重排（防止高度抖动） ---------- */
  var imgs = content ? content.querySelectorAll('img') : [];
  imgs.forEach(function (img) {
    img.addEventListener('load', function () { /* 面板自适应，无需计算 */ });
  });
});
</script>
<!-- 星图实时脚本：外链（源文件 themes/butterfly/source/js/theme/starmap/starmap-live.js） -->
<script src="/js/theme/starmap/starmap-live.js"></script>
<!-- 档案坐标空白区地球仪：纯 canvas 绘制，随窗口尺寸自适应（外链脚本） -->
<script src="/js/theme/home/globe.js"></script>
</body>
</html>

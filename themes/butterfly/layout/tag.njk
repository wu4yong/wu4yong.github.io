<!--
  ============================================
  单标签页面模板
  文件：tag.njk
  适用终端：电脑端
  作用：某标签下文章列表；手机 UA 跳 /phone/t/<标签>/
  最后修改：2026-11-11
  ============================================
--><!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#020817">
<!-- 首帧兜底：浏览器默认画布是白的，样式未解析前会闪一下白。这条规则先锁死深空底色 -->
<style>html{background-color:#020817}</style>
<title>{{ page.tag }} - 时空秘境</title>
<!-- 样式：基础层 + 标签详情页，外链引入（源文件 themes/butterfly/source/css/theme/） -->
<link rel="stylesheet" href="/css/theme/base/common.css">
<link rel="stylesheet" href="/css/theme/starmap/tag.css">
<script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('{{ phone_tag_url(page.tag) }}');
    }
  })();
</script>
</head>
<body>
  {% include "_components/Particles.njk" %}

  <div class="container">
    <div class="header">
      <h1>{{ page.tag }}</h1>
      <a href="/tags/" class="back-home">← 返回星迹索引</a>
    </div>
    <div class="post-list">
      {# 通过 slug 匹配标签 #}
      {% set found_posts = [] %}
      {% for tag in site.tags.toArray() %}
        {% if tag.slug == page.tag %}
          {% set found_posts = tag.posts.toArray() | sort(false, false, 'date') %}
        {% endif %}
      {% endfor %}
      
      {% if found_posts | length > 0 %}
        {% for post in found_posts %}
          <div class="post-item">
            <span style="color:#88aaff; font-size:14px; margin-right:15px;">{{ post.date.format('YYYY-MM-DD') }}</span>
            <a href="{{ url_for(post.path) }}">{{ post.title }}</a>
          </div>
        {% endfor %}
      {% else %}
        <div class="empty-tip">该标签下暂无文章</div>
      {% endif %}
    </div>
  </div>
</body>
</html>

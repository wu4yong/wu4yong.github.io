<!--
  ============================================
  单个标签页面模板
  文件：tag.njk
  作用：显示某个标签下的所有文章
  样式依赖：_css/common.css、_css/tag.css
  组件依赖：_components/Particles.njk
  ============================================
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>{{ page.tag }} - 时空秘境</title>
<style>
  {% include "_css/common.css" %}
  {% include "_css/tag.css" %}
</style>
</head>
<body>
  {% include "_components/Particles.njk" %}

  <div class="container">
    <div class="header">
      <h1>{{ page.tag }}</h1>
      <a href="/tags/" class="back-home">← 返回星标索引</a>
    </div>
    <div class="post-list">
      {# 通过 slug 匹配标签 #}
      {% set found_posts = [] %}
      {% for tag in site.tags.toArray() %}
        {% if tag.slug == page.tag %}
          {% set found_posts = tag.posts.toArray() | sort(false, false, 'date') %}
        {% endif %}
      {% endfor %}
      
      {% if found_posts | length > 0 %}
        {% for post in found_posts %}
          <div class="post-item">
            <span style="color:#88aaff; font-size:14px; margin-right:15px;">{{ post.date.format('YYYY-MM-DD') }}</span>
            <a href="/{{ post.path }}">{{ post.title }}</a>
          </div>
        {% endfor %}
      {% else %}
        <div class="empty-tip">该标签下暂无文章</div>
      {% endif %}
    </div>
  </div>
</body>
</html>

<!--
  ============================================
  星野歌单 · 雷达区播放器
  文件：StarJukebox.njk
  适用终端：电脑端（/archives/ 与 /tags/ 两个星图页）
  作用：在中间的雷达区域就地展开全屏播放器，不跳页面
    - 点侧栏「星野歌单」→ 雷达区替换成播放器，左右栏让位
    - 两种视图：背景歌词（stage）/ 左封面右歌词（split）
    - 三种播放模式：列表循环 / 单曲循环 / 随机
    - 背景是 canvas 画的星图雷达（同心轨道 + 旋转扫描 + 星座连线 + 粒子）
  数据：/music/playlist.json（曲目）+ /music/lyrics/<key>.lrc（歌词）
  说明：歌词文件缺省时自动降级为「曲名大字 + 频谱」，不会报错
  依赖：star-jukebox.css（同目录 CSS）、star-jukebox.js
  最后修改：2026-11-14
  ============================================
-->
<link rel="stylesheet" href="/css/theme/media/star-jukebox.css?v=20261115o">
<div class="star-jukebox" id="starJukebox" data-view="split" data-pane="both" data-open="false" aria-hidden="true">
  <canvas class="sj-radar" id="sjRadar"></canvas>

  <!-- 封面不再占右栏杆位：钉在左下角半透明垫底，
       歌单以后加多少首都从它上面走，不会被挡住 -->
  <div class="sj-cover" id="sjCover">
    <span class="sj-vinyl"></span>
    <span class="sj-vinyl-core"></span>
  </div>

  <div class="sj-head">
    <div class="sj-tabs" role="tablist">
      <button class="sj-tab is-on" type="button" data-pane="both">分栏</button>
      <button class="sj-tab" type="button" data-pane="stage">歌词</button>
      <button class="sj-tab" type="button" data-pane="list">歌单</button>
    </div>
    <div class="sj-head-right">
      <button class="sj-ghost" id="sjViewBtn" type="button" title="切换 分栏 / 背景歌词">背景</button>
      <button class="sj-ghost sj-close" id="sjCloseBtn" type="button" title="收起播放器">✕</button>
    </div>
  </div>

  <div class="sj-stage" id="sjStage">
    <div class="sj-meta">
      <h2 class="sj-title" id="sjTitle">星野歌单</h2>
      <p class="sj-artist" id="sjArtist">载入中…</p>
      <div class="sj-lyrics" id="sjLyrics">
        <div class="sj-lyric-empty">歌单载入中…</div>
      </div>
    </div>
  </div>

  <div class="sj-list" id="sjList" hidden></div>

  <div class="sj-bar">
    <div class="sj-time">
      <span id="sjCur">00:00</span><span class="sj-sep">/</span><span id="sjDur">00:00</span>
    </div>
    <div class="sj-progress" id="sjProgress" role="slider" tabindex="0" aria-label="播放进度">
      <span class="sj-progress-track"></span>
      <span class="sj-progress-fill" id="sjFill"></span>
      <span class="sj-progress-dot" id="sjDot"></span>
    </div>
    <div class="sj-actions">
      <div class="sj-vol" id="sjVolWrap">
        <button class="sj-btn sj-vol-btn" id="sjVolBtn" type="button" title="音量 / 静音">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path d="M3.5 9.5h3.2L11 5.6v12.8l-4.3-3.9H3.5z" fill="currentColor"></path>
            <path class="sj-vol-w1" d="M14.6 8.6a4.6 4.6 0 0 1 0 6.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            <path class="sj-vol-w2" d="M17.2 6.2a8 8 0 0 1 0 11.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            <path class="sj-vol-x1" d="M14.8 9.2l4 5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            <path class="sj-vol-x2" d="M18.8 9.2l-4 5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </button>
        <div class="sj-vol-pop" id="sjVolPop" hidden>
          <span class="sj-vol-track" id="sjVolTrack" role="slider" tabindex="0" aria-label="音量">
            <span class="sj-vol-fill" id="sjVolFill"></span>
            <span class="sj-vol-dot" id="sjVolDot"></span>
          </span>
          <span class="sj-vol-num" id="sjVolNum">100</span>
        </div>
      </div>
      <button class="sj-btn" id="sjPrev" type="button" title="上一首">◀◀</button>
      <button class="sj-btn sj-play" id="sjPlay" type="button" title="播放/暂停">▶</button>
      <button class="sj-btn" id="sjNext" type="button" title="下一首">▶▶</button>
      <button class="sj-btn sj-mode" id="sjMode" type="button" data-mode="loopAll" title="切换播放模式">列表循环</button>
    </div>
  </div>
</div>
<script defer src="/js/theme/media/star-jukebox.js?v=20261115l"></script>

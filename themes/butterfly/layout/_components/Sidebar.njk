<aside class="sidebar" id="sidebar">
  <div class="profile-card">
    <div class="avatar">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#0a0e27,#1a1a4e);display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:40px;border:2px solid #00eeff;box-shadow:0 0 30px rgba(0,238,255,0.3);">✨</div>
    </div>
    <h3 class="nickname">时空行者</h3>
    <p class="bio">星辰大海，代码为舟</p>
    <div class="stats">
      <div class="stat-item">
        <span class="stat-num">{{ site.posts.length }}</span>
        <span class="stat-label">文章</span>
      </div>
      <div class="stat-item">
        <span class="stat-num" id="fans-count" style="cursor:pointer;">1088</span>
        <span class="stat-label">粉丝</span>
      </div>
      <div class="stat-item">
        <span class="stat-num" id="follow-count" style="cursor:pointer;">66</span>
        <span class="stat-label">关注</span>
      </div>
    </div>
    <button class="follow-btn">+ 关注</button>
  </div>

  <div class="search-box">
    <input type="text" placeholder="找找看..." id="search-input">
    <button class="search-btn" id="searchModalOpen">🔍</button>
  </div>

  <div class="links-card">
    <h4>常用链接</h4>
    <ul>
      <li><a href="/archives/">我的随笔</a></li>
      <li><a href="/about/">关于我</a></li>
      <li><a href="/tags/">我的标签</a></li>
    </ul>
  </div>

  <div class="tags-card">
    <h4>热门标签</h4>
    <div class="tag-cloud">
      {% for tag in site.tags.toArray() | slice(0, 10) %}
        <a href="/tags/{{ tag.slug }}/" class="tag-link">{{ tag.name }}</a>
      {% endfor %}
    </div>
  </div>

  <div class="archive-card">
    <h4>按月归档</h4>
    <ul class="archive-list">
      {% set last_month = '' %}
      {% for post in site.posts.toArray() | sort(false, true, 'date') %}
        {% set current_month = post.date.format('YYYY-MM') %}
        {% if current_month != last_month %}
          {% set last_month = current_month %}
          <li>
            <a href="/archives/{{ post.date.format('YYYY') }}/{{ post.date.format('MM') }}/">
              {{ post.date.format('YYYY年MM月') }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- 搜索待实现弹窗 -->
<div class="modal-mask" id="searchModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>🔍 全文搜索</h3>
      <span class="modal-close" id="searchModalClose">×</span>
    </div>
    <div class="modal-body">
      <p>博主失联了，敬请期待✨</p>
    </div>
  </div>
</div>

</aside>

<!-- 引入侧边栏交互脚本 -->
<script>
  {% include "_js/sidebar.js" %}
</script>
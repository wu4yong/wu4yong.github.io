<aside class="sidebar">
  <div class="profile-card">
    <div class="avatar">
      <div style="width:80px;height:80px;border-radius:50%;background:#00eeff33;display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:40px;">🌌</div>
    </div>
    <h3 class="nickname">时空行者</h3>
    <p class="bio">星辰大海，代码为舟</p>
    <div class="stats">
      <div class="stat-item">
        <span class="stat-num">{{ site.posts.length }}</span>
        <span class="stat-label">文章</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">888</span>
        <span class="stat-label">粉丝</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">888</span>
        <span class="stat-label">关注</span>
      </div>
    </div>
    <button class="follow-btn">+ 关注</button>
  </div>

  <div class="search-box">
    <input type="text" placeholder="找找看..." id="search-input">
    <button id="search-btn">🔍</button>
  </div>

  <div class="links-card">
    <h4>常用链接</h4>
    <ul>
      <li>
        <a href="/archives/">我的随笔</a>
      </li>
      <li>
        <a href="/about/">关于我</a>
      </li>
      <li>
        <a href="/tags/">我的标签</a>
      </li>
    </ul>
  </div>

  <div class="tags-card">
    <h4>热门标签</h4>
    <div class="tag-cloud">
      {% for tag in site
        .tags
        .toArray() | slice(0, 10) %}
        <a href="/tags/{{ tag.name }}/" class="tag-link">{{ tag.name }}</a>
      {% endfor %}
    </div>
  </div>

  <div class="archive-card">
    <h4>按月归档</h4>
    <ul class="archive-list">
      {% set last_month = '' %}
      {% for post in site
        .posts
        .toArray() | sort(false, true, 'date') %}
        {% set current_month = post.date.format('YYYY-MM') %}
        {% if current_month != last_month %}
          {% set last_month = current_month %}
          <li>
            <a href="/archives/{{ post.date.year() }}/{{ post.date.month() }}/">
              {{ post.date.format('YYYY年MM月') }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var searchBtn = document.getElementById('search-btn');
    var searchInput = document.getElementById('search-input');
    if (searchBtn) {
      searchBtn.addEventListener('click', function () {
        var keyword = searchInput
          .value
          .trim();
        if (keyword) 
          window.location.href = '/search/?q=' + encodeURIComponent(keyword);
        }
      );
    }
    if (searchInput) {
      searchInput.addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          var keyword = searchInput
            .value
            .trim();
          if (keyword) 
            window.location.href = '/search/?q=' + encodeURIComponent(keyword);
          }
        });
    }
  });
</script>
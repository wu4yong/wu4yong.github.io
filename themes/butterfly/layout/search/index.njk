<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>搜索 - 时空秘境</title>
<style>
{% include "_css/common.css" %}
.search-container { position: relative; z-index: 10; max-width: 800px; margin: 0 auto; padding: 80px 20px; }
.search-header { text-align: center; margin-bottom: 40px; }
.search-header h1 { color: #00eeff; font-size: 42px; text-shadow: 0 0 20px #00eeff; }
.search-box { display: flex; gap: 10px; margin-bottom: 40px; }
.search-box input { flex: 1; padding: 15px; background: rgba(0, 22, 45, 0.7); border: 1px solid #00eeff; border-radius: 8px; color: #fff; font-size: 16px; }
.search-box button { padding: 15px 30px; background: rgba(0, 238, 255, 0.2); border: 1px solid #00eeff; border-radius: 8px; color: #00eeff; cursor: pointer; }
.result-list { background: rgba(0, 22, 45, 0.85); border-radius: 18px; padding: 30px; border: 1px solid #00eeff; }
.result-item { margin: 20px 0; padding: 15px; border-bottom: 1px solid #00eeff33; }
.result-item a { color: #00eeff; text-decoration: none; font-size: 20px; }
.result-date { color: #88aaff; font-size: 12px; margin-top: 8px; }
.no-result { text-align: center; color: #88aaff; padding: 40px; }
.back-home { display: inline-block; margin-top: 20px; padding: 10px 25px; background: rgba(0, 32, 65, 0.8); border: 1px solid #00eeff; border-radius: 30px; color: #00eeff; text-decoration: none; }
</style>
</head>
<body>
{% include "_components/Particles.njk" %}

<div class="search-container">
  <div class="search-header">
    <h1>🔍 搜索</h1>
    <a href="/" class="back-home">← 返回首页</a>
  </div>

  <div class="search-box">
    <input type="text" id="search-keyword" placeholder="输入关键词...">
    <button id="do-search">搜索</button>
  </div>

  <div class="result-list" id="search-results">
    <div class="no-result">请输入关键词开始搜索</div>
  </div>
</div>

<script>
var ALL_POSTS = [
  {% for post in site.posts.toArray() %}
  {
    title: {{ post.title | json | safe }},
    date: {{ post.date.format('YYYY-MM-DD') | json | safe }},
    url: {{ post.permalink | json | safe }},
    content: {{ post.content | striptags | replace('\n', ' ') | truncate(500) | json | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
];

function getQueryParam(name) {
  var match = window.location.search.match(new RegExp('[?&]' + name + '=([^&]+)'));
  return match ? decodeURIComponent(match[1]) : null;
}

function doSearch() {
  var keyword = document.getElementById('search-keyword').value.trim();
  var resultsDiv = document.getElementById('search-results');
  if (!keyword) {
    resultsDiv.innerHTML = '<div class="no-result">请输入关键词开始搜索</div>';
    return;
  }
  var keywordLower = keyword.toLowerCase();
  var results = ALL_POSTS.filter(function(post) {
    return post.title.toLowerCase().indexOf(keywordLower) > -1 ||
           post.content.toLowerCase().indexOf(keywordLower) > -1;
  });
  if (results.length === 0) {
    resultsDiv.innerHTML = '<div class="no-result">没有找到与 "' + keyword + '" 相关的文章</div>';
    return;
  }
  var html = '';
  results.forEach(function(post) {
    html += '<div class="result-item">';
    html += '<a href="' + post.url + '">' + post.title + '</a>';
    html += '<div class="result-date">' + post.date + '</div>';
    html += '</div>';
  });
  resultsDiv.innerHTML = html;
}

var query = getQueryParam('q');
var searchInput = document.getElementById('search-keyword');
if (query) {
  searchInput.value = query;
  doSearch();
}
document.getElementById('do-search').addEventListener('click', doSearch);
searchInput.addEventListener('keypress', function(e) {
  if (e.key === 'Enter') doSearch();
});
</script>
</body>
</html>

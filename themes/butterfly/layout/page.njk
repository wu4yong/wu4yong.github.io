<!--
  ============================================
  独立页面模板
  文件：page.njk
  适用终端：电脑端
  作用：自定义独立页（website 等）；手机 UA 跳 /phone/
  最后修改：2026-11-11
  ============================================
-->{% set pageTitle = page.title + " - 时空秘境" %}
{# 样式层级顺序：基础 common → 布局 post-layout → 组件 sidebar → 正文 post #}
{% set pageCss = ["base/common.css", "base/post-layout.css", "base/sidebar.css", "base/post.css"] %}
<!DOCTYPE html>
<html class="post-page">
{% include "_components/Head.njk" %}
<script>
  /* 手机 UA 分流：电脑端这套控制台不再给手机用，直接换成手机版页面 */
  (function () {
    var ua = navigator.userAgent || '';
    if (/Android|iPhone|iPod|HarmonyOS|Windows Phone|MicroMessenger|Mobile Safari/i.test(ua)) {
      location.replace('/phone/');
    }
  })();
</script>
<link rel="stylesheet" href="/css/code-table.css">

<body>
  {% include "_components/Particles.njk" %}

  <div class="app-layout">
    {% include "_components/Sidebar.njk" %}

    {# 折叠按钮：放在 aside 外部，不受侧边栏 transform 影响 #}
    <button id="sidebarToggle" class="sidebar-toggle" title="隐藏侧栏"></button>

    <main class="main-content">
      <div class="article-card">
        <h1 class="article-title">{{ page.title }}</h1>
        {% if page.date %}
        <div class="article-meta">📅 {{ page.date.format('YYYY-MM-DD') }}</div>
        {% endif %}
        <div class="article-content">{{ page.content }}</div>
      </div>
    </main>
  </div>

  <div class="float-buttons">
    <button id="back-to-top" class="float-btn" title="返回顶部">↑</button>
    <a href="/" class="float-btn" title="返回首页">🏠</a>
  </div>

  {# sidebar.js 由 _components/Sidebar.njk 内部引入，这里不再重复 #}
  <!-- 浮动按钮脚本：外链（源文件 themes/butterfly/source/js/theme/base/post-float-btn.js） -->
  <script src="/js/theme/base/post-float-btn.js"></script>

  {% if page.player !== false %}
    {% include "_components/APlayer.njk" %}
  {% endif %}
</body>
</html>

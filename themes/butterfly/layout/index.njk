<!--
  ============================================
  首页模板
  文件：index.njk
  作用：博客首页入口，只负责引入样式、组件和脚本
  样式：_css/common.css + _css/home.css + _css/home-animation.css
  组件：_components/Particles.njk + _components/HomeContent.njk
  脚本：_js/typing.js + _js/home-parallax.js
  ============================================
-->
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>时空秘境</title>
    <style>
      {% include "_css/common.css" %}
      {% include "_css/home.css" %}
      {% include "_css/home-animation.css" %}
    </style>
  </head>
  <body>
    <!-- 星空粒子背景组件 -->
    {% include "_components/Particles.njk" %}

    <!-- 首页内容组件（按钮、折叠菜单）- 内部元素各自添加动画类 -->
    {% include "_components/HomeContent.njk" %}

    <!-- 首页脚本（打字机 + 折叠功能 + 视差效果） -->
    <script>
      {% include "_js/typing.js" %}
    </script>
    <script>
      {% include "_js/home-parallax.js" %}
    </script>
  </body>
</html>
